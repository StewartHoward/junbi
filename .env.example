# App database connection. Use a NON-superuser role so row-level security applies.
DATABASE_URL=postgres://junbi_app:junbi_app@localhost:5432/junbi

# Owner connection used only for migrations and seeding.
DATABASE_ADMIN_URL=postgres://junbi:junbi@localhost:5432/junbi

# Development only: lets you pick a user on /dev/login. Never set this in production.
JUNBI_DEV_LOGIN=1
